        "askpass"
      ],
      "Suggests": [
        "curl",
        "testthat (>= 2.1.0)",
        "digest",
        "knitr",
        "rmarkdown",
        "jsonlite",
        "jose",
        "sodium"
      ],
      "RoxygenNote": "7.3.2",
      "Encoding": "UTF-8",
      "NeedsCompilation": "yes",
      "Author": "Jeroen Ooms [aut, cre] (<https://orcid.org/0000-0002-4035-0289>), Oliver Keyes [ctb]",
      "Maintainer": "Jeroen Ooms <jeroenooms@gmail.com>",
      "Repository": "CRAN"
    },
