        "tidyverse"
      ],
      "biocViews": "DifferentialExpression, Microbiome, Normalization, Sequencing, Software",
      "BugReports": "https://github.com/FrederickHuangLin/ANCOMBC/issues",
      "URL": "https://github.com/FrederickHuangLin/ANCOMBC",
