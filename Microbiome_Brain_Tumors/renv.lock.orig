        "utils",
        "Matrix (>= 1.0-12)"
      ],
      "LinkingTo": [
        "Matrix",
        "RcppEigen"
      ],
      "Suggests": [
        "numDeriv",
        "parallel"
      ],
      "RoxygenNote": "7.2.3",
      "NeedsCompilation": "yes",
      "Repository": "CRAN"
    },
