    "statmod": {
      "Package": "statmod",
      "Version": "1.5.0",
      "Source": "Repository",
      "Date": "2022-12-28",
      "Title": "Statistical Modeling",
      "Author": "Gordon Smyth [cre, aut], Lizhong Chen [aut], Yifang Hu [ctb], Peter Dunn [ctb], Belinda Phipson [ctb], Yunshun Chen [ctb]",
      "Maintainer": "Gordon Smyth <smyth@wehi.edu.au>",
